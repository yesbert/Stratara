<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <PackageId>Stratara.Identity.EntityFrameworkCore</PackageId>
        <Description>EF Core identity-directory plane for the Stratara stack — user↔tenant membership store (many-to-many with tenant-scoped roles and active-tenant selection), membership-backed IAuthorizationProvider (tenant roles plus global ASP.NET Identity roles), a membership-backed cross-tenant authorizer for strict tenant isolation, a code-first permission catalog with membership/role-driven resolvers, a scoped settings plane (global/tenant/user/user-in-tenant with optional at-rest encryption), and an API-key/PAT store whose keys resolve through the same membership plane.</Description>
        <PackageTags>multitenancy;membership;authorization;identity;efcore;rbac;dotnet;stratara</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Identity.Core"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stratara.Abstractions\Stratara.Abstractions.csproj"/>
        <ProjectReference Include="..\Stratara.Diagnostics\Stratara.Diagnostics.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Stratara.Identity.EntityFrameworkCore.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\icon.png" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
