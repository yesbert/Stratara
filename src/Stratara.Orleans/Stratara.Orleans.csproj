<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Proof of concept of change prove-an-orleans-execution-model (Tier-C). Not packable and not in
             Stratara.Publish.slnf: nothing here is published until a follow-up change decides so. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stratara.Abstractions\Stratara.Abstractions.csproj"/>
        <ProjectReference Include="..\Stratara.EventSourcing.EntityFrameworkCore\Stratara.EventSourcing.EntityFrameworkCore.csproj"/>
        <ProjectReference Include="..\Stratara.Projections\Stratara.Projections.csproj"/>
        <ProjectReference Include="..\Stratara.Resilience\Stratara.Resilience.csproj"/>
        <ProjectReference Include="..\Stratara.Sagas\Stratara.Sagas.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Reminders"/>
        <PackageReference Include="Microsoft.Orleans.Sdk"/>
        <PackageReference Include="Microsoft.Orleans.Server"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Stratara.Orleans.Tests"/>
        <InternalsVisibleTo Include="Stratara.Orleans.IntegrationTests"/>
        <InternalsVisibleTo Include="Stratara.Orleans.Benchmarks"/>
    </ItemGroup>

</Project>
