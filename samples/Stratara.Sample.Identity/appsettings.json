{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "OpenIdConnect": {
      "Authority": "https://login.example.com/replace-me/v2.0",
      "ClientId": "replace-with-your-client-id",
      "ClientSecret": "replace-with-your-client-secret",
      "CallbackPath": "/signin-oidc"
    },
    "JwtBearer": {
      "Authority": "https://login.example.com/replace-me/v2.0",
      "Audience": "api://stratara-sample",
      "ValidIssuers": [
        "https://login.example.com/replace-me/v2.0"
      ]
    }
  }
}
