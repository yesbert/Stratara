<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Stratara.Sample.OrleansExecutionModel</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The documented exception: a sample runs the execution model on the test host so it needs no cluster,
             broker or database server. A production host composes the execution model against real infrastructure. -->
        <StrataraAllowTestSupportOutsideTests>true</StrataraAllowTestSupportOutsideTests>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Stratara.Testing.Orleans\Stratara.Testing.Orleans.csproj" />
    </ItemGroup>

</Project>
