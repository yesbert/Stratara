<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The test project this executable hosts scenarios for brings xunit's generated entry point
             along; this names the real one. -->
        <StartupObject>Stratara.Orleans.Benchmarks.Program</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet"/>
        <!-- BenchmarkDotNet floats on Roslyn 4.14 and the Orleans SDK on Roslyn 5.0 with an exact
             Workspaces pin; the three direct references lift both to the version the repository
             already uses for Microsoft.CodeAnalysis.CSharp. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Common"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Stratara.Orleans\Stratara.Orleans.csproj"/>
        <!-- The scenarios the integration tests kill and restart live in the test project; this
             executable hosts them because a test assembly cannot host itself. -->
        <ProjectReference Include="..\Stratara.Orleans.IntegrationTests\Stratara.Orleans.IntegrationTests.csproj"/>
    </ItemGroup>

</Project>
