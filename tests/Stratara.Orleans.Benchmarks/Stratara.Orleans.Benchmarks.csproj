<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <StartupObject>Stratara.Orleans.Benchmarks.Program</StartupObject>
    </PropertyGroup>

    <!-- A benchmark run that starts scenario hosts starts this executable; PocHostProcess finds it here. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>StrataraScenarioHost</_Parameter1>
            <_Parameter2>$(TargetPath)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet"/>
        <!-- BenchmarkDotNet floats on Roslyn 4.14 and the Orleans SDK on Roslyn 5.0 with an exact
             Workspaces pin; the three direct references lift both to the version the repository
             already uses for Microsoft.CodeAnalysis.CSharp. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Common"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Stratara.Orleans\Stratara.Orleans.csproj"/>
        <ProjectReference Include="..\..\src\Stratara.Orleans.EntityFrameworkCore\Stratara.Orleans.EntityFrameworkCore.csproj"/>
        <!-- The scenarios the integration tests kill and restart; this executable hosts them because a test
             assembly cannot host itself. -->
        <ProjectReference Include="..\Stratara.Orleans.Scenarios\Stratara.Orleans.Scenarios.csproj"/>
    </ItemGroup>

</Project>
