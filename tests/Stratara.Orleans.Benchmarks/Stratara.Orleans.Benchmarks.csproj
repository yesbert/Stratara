<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet"/>
        <!-- BenchmarkDotNet floats on Roslyn 4.14 and the Orleans SDK on Roslyn 5.0 with an exact
             Workspaces pin; the three direct references lift both to the version the repository
             already uses for Microsoft.CodeAnalysis.CSharp. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Common"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Stratara.Orleans\Stratara.Orleans.csproj"/>
    </ItemGroup>

</Project>
