<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet"/>
        <PackageReference Include="Microsoft.Orleans.GrainDirectory.Redis"/>
        <PackageReference Include="Microsoft.Orleans.Reminders.AdoNet"/>
        <PackageReference Include="Microsoft.Orleans.Sdk"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="SSH.NET"/>
        <PackageReference Include="Testcontainers.PostgreSql"/>
        <PackageReference Include="Testcontainers.RabbitMq"/>
        <PackageReference Include="Testcontainers.Redis"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="coverlet.collector"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Stratara.EventSourcing.WorkerDefaults/Stratara.EventSourcing.WorkerDefaults.csproj"/>
        <ProjectReference Include="../../src/Stratara.Orleans/Stratara.Orleans.csproj"/>
        <ProjectReference Include="../../src/Stratara.Orleans.EntityFrameworkCore/Stratara.Orleans.EntityFrameworkCore.csproj"/>
        <ProjectReference Include="../../src/Stratara.Validation/Stratara.Validation.csproj"/>
        <ProjectReference Include="../Stratara.Orleans.Scenarios/Stratara.Orleans.Scenarios.csproj"/>
        <!-- The scenario host the kill tests start: built with this project, never referenced as an assembly. -->
        <ProjectReference Include="$(ScenarioHostProject)" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <PropertyGroup>
        <ScenarioHostProject>$(MSBuildThisFileDirectory)../Stratara.Orleans.Benchmarks/Stratara.Orleans.Benchmarks.csproj</ScenarioHostProject>
    </PropertyGroup>

    <!-- Records where the scenario host was built, as assembly metadata PocHostProcess reads; the environment
         variable STRATARA_SCENARIO_HOST overrides it. The path follows the build's configuration and output
         directory rather than the test output's layout. -->
    <Target Name="EmbedScenarioHostPath" BeforeTargets="GetAssemblyAttributes">
        <MSBuild Projects="$(ScenarioHostProject)" Targets="GetTargetPath" RemoveProperties="TargetFramework">
            <Output TaskParameter="TargetOutputs" PropertyName="ScenarioHostTargetPath"/>
        </MSBuild>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>StrataraScenarioHost</_Parameter1>
                <_Parameter2>$(ScenarioHostTargetPath)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>
</Project>
